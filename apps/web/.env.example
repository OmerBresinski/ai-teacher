# @tj/web -- copied to `.env` by `bun run setup` (never overwritten). Vite exposes only variables
# prefixed VITE_ to the browser bundle; they are validated at module load in src/env.ts (ADR 0015).
#
# GENERATED from infra/env.contract.ts by `bun run env:generate` -- do not edit by hand.
# On Vercel both VITE_* values are resolved at build time by scripts/vercel-env.ts (repo root):
#   Production  -> VITE_APP_ENV=production, VITE_API_URL from the project's Production variable
#   Preview     -> VITE_APP_ENV=preview,  VITE_API_URL = RAILWAY_PR_API_URL_TEMPLATE with {pr}
#                  replaced by VERCEL_GIT_PULL_REQUEST_ID, else VITE_API_URL_FALLBACK
# RAILWAY_PR_API_URL_TEMPLATE and VITE_API_URL_FALLBACK are Vercel Preview variables only --
# they are never read by the app and do not belong in a local .env (docs/env.md).

# Base URL the browser uses for the API. Locally `/api`: the Vite dev server proxies `/api/*` to
# the api and strips the prefix so cookies stay same-origin. A production build requires an
# absolute URL — Vercel Production holds the Railway api origin
# (`https://api-production-903f.up.railway.app` today, `https://api.<domain>` once a domain
# exists); previews derive it (see RAILWAY_PR_API_URL_TEMPLATE).
VITE_API_URL=/api

# development | preview | production. Only `production` loads Vercel Speed Insights. On Vercel
# `scripts/vercel-env.ts` sets it from VERCEL_ENV at build time.
# (one of: development | preview | production)
VITE_APP_ENV=development

# Where the Vite dev proxy forwards `/api/*` (default `http://localhost:3001`). Read by
# `vite.config.ts` only, never bundled.
# VITE_DEV_API_TARGET=
