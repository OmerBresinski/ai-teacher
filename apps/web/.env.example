# @tj/web -- copied to `.env` by `bun run setup` (never overwritten). Vite exposes only variables
# prefixed VITE_ to the browser bundle; they are validated at module load in src/env.ts (ADR 0015).

# Base URL the browser uses for the API. In development keep `/api`: the Vite dev server proxies
# `/api/*` to the API and strips the prefix, so auth cookies stay same-origin (ADR 0008). A
# production build requires an absolute URL, e.g. https://api.teachingjourney.app
VITE_API_URL=/api

# development | preview | production. `production` is the only value that loads Vercel Speed
# Insights (src/lib/speed-insights.ts); preview/dev bundles contain none of it.
VITE_APP_ENV=development

# On Vercel both values above are resolved at build time by scripts/vercel-env.ts (repo root):
#   Production  -> VITE_APP_ENV=production, VITE_API_URL from the project's Production variable
#   Preview     -> VITE_APP_ENV=preview,  VITE_API_URL = RAILWAY_PR_API_URL_TEMPLATE with {pr}
#                  replaced by VERCEL_GIT_PULL_REQUEST_ID, else VITE_API_URL_FALLBACK
# RAILWAY_PR_API_URL_TEMPLATE and VITE_API_URL_FALLBACK are Vercel Preview variables only —
# they are never read by the app and do not belong in a local .env.

# Where the dev proxy forwards `/api/*` (read by vite.config.ts only, never bundled).
# VITE_DEV_API_TARGET=http://localhost:3001
