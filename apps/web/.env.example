# @tj/web -- copied to `.env` by `bun run setup` (never overwritten). Vite exposes only variables
# prefixed VITE_ to the browser bundle; they are validated at module load in src/env.ts (ADR 0015).

# Base URL the browser uses for the API. In development keep `/api`: the Vite dev server proxies
# `/api/*` to the API and strips the prefix, so auth cookies stay same-origin (ADR 0008). A
# production build requires an absolute URL, e.g. https://api.teachingjourney.app
VITE_API_URL=/api

# development | preview | production
VITE_APP_ENV=development

# Where the dev proxy forwards `/api/*` (read by vite.config.ts only, never bundled).
# VITE_DEV_API_TARGET=http://localhost:3001
