{
  "name": "@tj/web",
  "version": "0.0.0",
  "private": true,
  "description": "Teaching Journey web app: Vite + React SPA with code-based TanStack Router and TanStack Query (ADR 0004).",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --port 5173 --strictPort",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "MODE=test bun test ${CI:+--coverage}",
    "test:watch": "bun test --watch",
    "test:e2e": "bun --bun playwright test",
    "test:e2e:ui": "bun --bun playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tj/api-client": "workspace:*",
    "@tj/domain": "workspace:*",
    "@tj/editor": "workspace:*",
    "@tj/ui": "workspace:*",
    "@vercel/speed-insights": "2.0.0",
    "gsap": "3.15.0",
    "hono": "4.13.8",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.103.2",
    "@tanstack/react-router-devtools": "1.167.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tj/config": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jszip": "3.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
