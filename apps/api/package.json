{
  "name": "@tj/api",
  "version": "0.0.0",
  "private": true,
  "description": "Teaching Journey HTTP API: Hono on Bun, Hono RPC contract for apps/web (ADR 0005, 0010, 0015).",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts --target=bun --outdir=dist && bun build src/sources/extract-child.ts --target=node --outfile=dist/sources/extract-child.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tj/ai": "workspace:*",
    "@tj/db": "workspace:*",
    "@tj/domain": "workspace:*",
    "@tj/extract": "workspace:*",
    "@tj/images": "workspace:*",
    "@tj/jobs": "workspace:*",
    "@tj/storage": "workspace:*",
    "ai": "7.0.97",
    "better-auth": "1.7.4",
    "hono": "4.13.7",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tj/config": "workspace:*",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3"
  }
}
