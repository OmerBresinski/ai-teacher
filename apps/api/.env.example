# @tj/api -- local settings for `bun run dev` / `bun test` inside apps/api (ADR 0015).
#
# Bun loads `.env` from the process cwd only, so this file is what the API sees when started from
# this directory (turbo does not load env files). `bun run setup` copies it to `.env` once.
# Real values live in Railway; never commit secrets.

# development | test | production. Controls pretty logging (development only).
NODE_ENV=development

# TCP port for Bun.serve.
PORT=3001

# Postgres connection used for /health and, later, every tenant query via forWorkspace().
# Keep the port in sync with TJ_PG_PORT in the root `.env`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey

# Comma-separated list of browser origins allowed by CORS (credentials are allowed).
WEB_ORIGIN=http://localhost:5173

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Test database for `bun test` inside apps/api (health integration test). Never the same as
# DATABASE_URL: tests may truncate tables.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey_test

# --- Auth (ADR 0008, TEACH-20) ----------------------------------------------------------------

# Signs session cookies and magic-link tokens. REQUIRED, at least 32 characters. Generate with:
#   openssl rand -base64 32
# (`bun run setup` will generate it for you once TEACH-26 lands.)
# BETTER_AUTH_SECRET=

# Public origin of this API. Magic links are `<BETTER_AUTH_URL>/auth/magic-link/verify?...`.
BETTER_AUTH_URL=http://localhost:3001

# Cookie strategy (see apps/api/README.md "Auth"):
# - local dev: leave both unset; the Vite dev proxy makes web and api same-origin.
# - production: COOKIE_DOMAIN=.<parent-domain> so app.<d> and api.<d> share the session cookie.
# - previews on unrelated origins: COOKIE_SAMESITE=none (cookies are Secure in production).
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=lax

# Magic-link delivery. Only `console` exists until F17: the link is printed in the api log.
MAIL_PROVIDER=console

# OAuth (F17). Leave unset to disable the provider; the api logs "Google sign-in disabled".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# "1" mounts the test-only routes (TEACH-22). Refused when NODE_ENV=production.
# ENABLE_TEST_ROUTES=
