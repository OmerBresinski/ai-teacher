# @tj/api -- local settings for `bun run dev` / `bun test` inside apps/api (ADR 0015).
#
# GENERATED from infra/env.contract.ts by `bun run env:generate` -- do not edit by hand.
# Bun loads `.env` from the process cwd only, so this file is what the API sees when started from
# this directory (turbo does not load env files). `bun run setup` copies it to `.env` once and
# generates BETTER_AUTH_SECRET. Real values live in Railway; never commit secrets. See docs/env.md.

# Postgres connection of the app database (pg-boss installs its own `pgboss` schema in it).
# Locally the compose database; keep the port in sync with TJ_PG_PORT. On Railway a reference to
# the `postgres` service over the private network. Contains the password: treat as a secret.
# (SECRET -- never commit a real value)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey

# Database the test suites and Playwright use (`@tj/db/testing`, docs/testing.md). Tests TRUNCATE
# tables here, so it must never equal DATABASE_URL. Never read by a running server.
# (SECRET -- never commit a real value)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey_test

# development | test | production. `development` switches on pino-pretty; `production` refuses
# ENABLE_TEST_ROUTES and ALLOW_WORKSPACE_HEADER_SHIM.
# (one of: development | test | production)
NODE_ENV=development

# TCP port of Bun.serve: api 3001 (HTTP + SSE), worker 3002 (`/health` only). Railway routes the
# public domain to the api's PORT; the worker has no public domain.
PORT=3001

# pino level: fatal | error | warn | info | debug | trace | silent.
# (one of: fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Comma-separated exact browser origins allowed by CORS (credentials on) and trusted by
# better-auth. Locally the Vite dev server; on Railway the Vercel production origin
# (`https://teaching-journey-web.vercel.app`, later `https://app.<domain>`).
WEB_ORIGIN=http://localhost:5173

# Optional comma-separated origin GLOBS for per-deployment Vercel preview URLs (`*` = one DNS
# label, no path), e.g. `https://teaching-journey-web-*-omerbresinskis-projects.vercel.app`. Set
# on Railway production so PR environments (copies of production) inherit it; the api ignores it
# when no preview origin matches. Unset locally.
# WEB_ORIGIN_PATTERNS=

# Signs session cookies and magic-link tokens; REQUIRED, at least 32 characters. `bun run setup`
# generates it into apps/api/.env (crypto.randomBytes(32), base64url) and never prints it;
# `infra/railway/provision.sh` does the same on Railway (`openssl rand -base64 32 | railway
# variable set BETTER_AUTH_SECRET --stdin`). Rotating it signs everyone out.
# (SECRET -- never commit a real value; generated by `bun run setup` when missing)
# BETTER_AUTH_SECRET=

# Public origin of this API; magic links are `<BETTER_AUTH_URL>/auth/magic-link/verify?...`. On
# Railway the reference `https://${{RAILWAY_PUBLIC_DOMAIN}}` resolves per environment (PR envs
# included).
BETTER_AUTH_URL=http://localhost:3001

# Parent domain of the session cookie (`.<domain>`) so app.<domain> and api.<domain> share it.
# Unset locally (the Vite proxy makes web and api same-origin) and until custom domains exist (ADR
# 0010).
# COOKIE_DOMAIN=

# lax (default) | none | strict. `none` makes the cookie `SameSite=None; Secure` (Secure forced
# whatever NODE_ENV, boot warning) for web and api on unrelated origins — Vercel preview <->
# Railway PR api, and **production today** (`*.vercel.app` <-> `*.up.railway.app`, set
# 2026-09-04). Once `app.<d>`/`api.<d>` exist, switch production to `lax` + COOKIE_DOMAIN (ADR
# 0008).
# (one of: lax | none | strict)
# COOKIE_SAMESITE=

# Magic-link delivery. Only `console` exists until TEACH-29 configures a real provider. In
# production it is refused unless ALLOW_CONSOLE_MAIL_IN_PRODUCTION=1; each link is printed in the
# api log at warn level.
# (one of: console)
MAIL_PROVIDER=console

# Acknowledges that with MAIL_PROVIDER=console in production every magic-link URL is printed to
# the api log. Required for console mail in production; delete when TEACH-29 lands.
# (one of: 1)
# ALLOW_CONSOLE_MAIL_IN_PRODUCTION=

# OAuth client id (F17). Unset disables Google sign-in (the api logs `Google sign-in disabled`).
# GOOGLE_CLIENT_ID=

# OAuth client secret paired with GOOGLE_CLIENT_ID (F17).
# (SECRET -- never commit a real value)
# GOOGLE_CLIENT_SECRET=

# OAuth application (client) id (F17). Unset disables Microsoft sign-in.
# MICROSOFT_CLIENT_ID=

# OAuth client secret paired with MICROSOFT_CLIENT_ID (F17).
# (SECRET -- never commit a real value)
# MICROSOFT_CLIENT_SECRET=

# "1" mounts the test-only routes (`/__test/*`, TEACH-22) when NODE_ENV=test. Refused at boot when
# NODE_ENV=production; never set it on Railway.
# (one of: 1)
# ENABLE_TEST_ROUTES=

# Development/test only: lets x-tj-workspace-id select a Workspace without a session. Refused at
# boot when NODE_ENV=production; never set it on Railway.
# (one of: 1)
ALLOW_WORKSPACE_HEADER_SHIM=1

# Vercel Blob read-write token for the private store `teaching-journey` (`store_Ii6wcxuuLOvPP4ou`,
# `fra1`; infra/README.md "Vercel Blob (files)"). When set (non-blank) `@tj/storage` picks
# `VercelBlobStorage`; otherwise the local-disk adapter under `.data/`. Set on Railway api +
# worker since 2026-09-04 (TEACH-37); never on Vercel — the SPA does not read it. Optional in CI
# to run the Blob contract tests.
# (SECRET -- never commit a real value)
# BLOB_READ_WRITE_TOKEN=

# Local-disk adapter only: base URL returned by `getSignedUrl` instead of `file://` paths.
# STORAGE_PUBLIC_BASE_URL=

# Local-disk adapter only: directory that holds stored objects. Defaults to `.data/storage`
# (gitignored) when unset.
# STORAGE_ROOT=

# Comma-separated key prefixes treated as public by `@tj/storage` (served by URL instead of the
# `GET /files/:key` proxy). Empty means everything is private. Leave unset on Railway: the
# production store `teaching-journey` is a **private** store and rejects `access: "public"`
# uploads.
# STORAGE_PUBLIC_PREFIXES=

# Amazon Bedrock API key (bearer). Required in production; when unset in development/test `@tj/ai`
# is `unconfigured` and AI jobs/routes fail fast. Never set on Vercel (ADR 0018).
# (SECRET -- never commit a real value)
# AWS_BEARER_TOKEN_BEDROCK=

# Amazon Bedrock region. `us-east-1` is the data-residency deviation recorded in ADR 0016 §5;
# production uses this value (ADR 0018).
AWS_REGION=us-east-1

# Bedrock model ID for the F13 §7 frontier class: planning, adaptation and coherence.
AI_MODEL_FRONTIER=us.anthropic.claude-opus-5

# Bedrock model ID for the F13 §7 standard class: plan, notes and slide outline generation.
AI_MODEL_STANDARD=us.anthropic.claude-sonnet-5

# Bedrock model ID for the F13 §7 small class: items, glossary, variants and summaries.
AI_MODEL_SMALL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Mastra core is used in-process by @tj/generation (ADR 0025 §21); its anonymous telemetry
# (`posthog-node`) is disabled.
MASTRA_TELEMETRY_DISABLED=1

# Concurrent SSE streams per Workspace before `429 rate_limited` (default 20).
# EVENTS_MAX_STREAMS_PER_WORKSPACE=

# Most `job_events` rows replayed when a stream opens (default 500, max 5000).
# EVENTS_REPLAY_LIMIT=

# Interval of the `: ping` SSE comment that keeps proxies awake (default 15000).
# EVENTS_HEARTBEAT_MS=

# Poll interval while the LISTEN connection is down — degraded mode (default 1000).
# EVENTS_POLL_MS=

# Model-call requests per Workspace per window on `POST /jobs/ai-ping` before `429 rate_limited`
# (default 10).
# AI_RATE_LIMIT_PER_WORKSPACE=

# Window length in seconds for `AI_RATE_LIMIT_PER_WORKSPACE` (default 60).
# AI_RATE_LIMIT_WINDOW_S=
