# @tj/api -- local settings for `bun run dev` / `bun test` inside apps/api (ADR 0015).
#
# GENERATED from infra/env.contract.ts by `bun run env:generate` -- do not edit by hand.
# Bun loads `.env` from the process cwd only, so this file is what the API sees when started from
# this directory (turbo does not load env files). `bun run setup` copies it to `.env` once and
# generates BETTER_AUTH_SECRET. Real values live in Railway; never commit secrets. See docs/env.md.

# Postgres connection of the app database (pg-boss installs its own `pgboss` schema in it).
# Locally the compose database; keep the port in sync with TJ_PG_PORT. On Railway a reference to
# the `postgres` service over the private network. Contains the password: treat as a secret.
# (SECRET -- never commit a real value)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey

# Database the test suites and Playwright use (`@tj/db/testing`, docs/testing.md). Tests TRUNCATE
# tables here, so it must never equal DATABASE_URL. Never read by a running server.
# (SECRET -- never commit a real value)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey_test

# development | test | production. `development` switches on pino-pretty; `production` refuses
# ENABLE_TEST_ROUTES and ALLOW_WORKSPACE_HEADER_SHIM.
# (one of: development | test | production)
NODE_ENV=development

# TCP port of Bun.serve: api 3001 (HTTP + SSE), worker 3002 (`/health` only). Railway routes the
# public domain to the api's PORT; the worker has no public domain.
PORT=3001

# pino level: fatal | error | warn | info | debug | trace | silent.
# (one of: fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Comma-separated exact browser origins allowed by CORS (credentials on) and trusted by
# better-auth. Locally the Vite dev server; on Railway the Vercel production origin
# (`https://teaching-journey-web.vercel.app`, later `https://app.<domain>`).
WEB_ORIGIN=http://localhost:5173

# Optional comma-separated origin GLOBS for per-deployment Vercel preview URLs (`*` = one DNS
# label, no path), e.g. `https://teaching-journey-web-*-omerbresinskis-projects.vercel.app`. Set
# on Railway production so PR environments (copies of production) inherit it; the api ignores it
# when no preview origin matches. Unset locally.
# WEB_ORIGIN_PATTERNS=

# Signs session cookies and magic-link tokens; REQUIRED, at least 32 characters. `bun run setup`
# generates it into apps/api/.env (crypto.randomBytes(32), base64url) and never prints it;
# `infra/railway/provision.sh` does the same on Railway (`openssl rand -base64 32 | railway
# variable set BETTER_AUTH_SECRET --stdin`). Rotating it signs everyone out.
# (SECRET -- never commit a real value; generated by `bun run setup` when missing)
# BETTER_AUTH_SECRET=

# Public origin of this API; magic links are `<BETTER_AUTH_URL>/auth/magic-link/verify?...`. On
# Railway the reference `https://${{RAILWAY_PUBLIC_DOMAIN}}` resolves per environment: the custom
# domain `api.bresinski.org` in production (Railway swaps it in once a custom domain is attached,
# TEACH-36), `api-ai-teacher-pr-<n>.up.railway.app` in a PR environment. Keep the reference; an
# explicit value would be copied into PR environments and point their magic links at production.
BETTER_AUTH_URL=http://localhost:3001

# Parent domain of the session cookie (`.bresinski.org`) so app.bresinski.org and
# api.bresinski.org share it (TEACH-36, ADR 0010). Unset locally (the Vite proxy makes web and api
# same-origin). PR environments inherit it (hence `both`); their api is on `*.up.railway.app`, not
# under it, so `effectiveCookieDomain()` ignores it with a boot warning and the cookie is
# host-only.
# COOKIE_DOMAIN=

# lax (default) | none | strict. Production is `lax` with COOKIE_DOMAIN since TEACH-36
# (app.bresinski.org / api.bresinski.org are first-party; WebKit blocks third-party cookies, which
# is why the earlier `none` stopgap failed on every iOS browser). `none` makes the cookie
# `SameSite=None; Secure` (boot warning) and is only for a Vercel preview <-> Railway PR api pair
# on unrelated origins.
# (one of: lax | none | strict)
# COOKIE_SAMESITE=

# Magic-link delivery. `resend` (Railway, TEACH-35) sends through Resend and needs RESEND_API_KEY
# + MAIL_FROM; `console` (local) prints each link in the api log and is refused in production
# unless ALLOW_CONSOLE_MAIL_IN_PRODUCTION=1. Set by hand on production (PR environments are copies
# of it); provision.sh deliberately does not seed it, so a freshly provisioned api refuses to boot
# until mail is configured rather than falling back to links in the log.
# (one of: console | resend)
MAIL_PROVIDER=console

# Resend send-only API key (resend.com → API Keys, permission 'Sending access'). Required when
# MAIL_PROVIDER=resend; the api refuses to boot without it. Set on Railway production, inherited
# by PR environments (they deliver sign-in mail the same way), never in git.
# (SECRET -- never commit a real value)
# RESEND_API_KEY=

# Sender of the magic-link email, RFC 5322 (`Teaching Journey <sign-in@mail.bresinski.org>`). The
# domain must be verified in Resend (EU region, ADR 0016). Required when MAIL_PROVIDER=resend.
# MAIL_FROM=

# Acknowledges that with MAIL_PROVIDER=console in production every magic-link URL is printed to
# the api log. Not set anywhere since TEACH-35 (Railway runs MAIL_PROVIDER=resend) and never
# seeded by provision.sh; only for an emergency fallback to console mail.
# (one of: 1)
# ALLOW_CONSOLE_MAIL_IN_PRODUCTION=

# OAuth client id (F17). Unset disables Google sign-in (the api logs `Google sign-in disabled`).
# GOOGLE_CLIENT_ID=

# OAuth client secret paired with GOOGLE_CLIENT_ID (F17).
# (SECRET -- never commit a real value)
# GOOGLE_CLIENT_SECRET=

# OAuth application (client) id (F17). Unset disables Microsoft sign-in.
# MICROSOFT_CLIENT_ID=

# OAuth client secret paired with MICROSOFT_CLIENT_ID (F17).
# (SECRET -- never commit a real value)
# MICROSOFT_CLIENT_SECRET=

# "1" mounts the test-only routes (`/__test/*`, TEACH-22) when NODE_ENV=test. Refused at boot when
# NODE_ENV=production; never set it on Railway.
# (one of: 1)
# ENABLE_TEST_ROUTES=

# Development/test only: lets x-tj-workspace-id select a Workspace without a session. Refused at
# boot when NODE_ENV=production; never set it on Railway.
# (one of: 1)
ALLOW_WORKSPACE_HEADER_SHIM=1

# Bucket name of the Railway Bucket `files` (`ams`; `railway bucket credentials --bucket files
# --json` → `bucketName`; infra/README.md "Railway Bucket (files)"). When set (non-blank)
# `@tj/storage` picks `S3Storage` and the other `S3_*` variables become required; otherwise the
# local-disk adapter under `.data/`. Set on Railway api + worker (TEACH-142); never on Vercel —
# the SPA does not read it. Optional in CI to run the S3 contract tests.
# S3_BUCKET=

# S3 API endpoint of the Railway Bucket (`railway bucket credentials` → `endpoint`). Requests are
# path-style (`<endpoint>/<bucket>/<key>`, ADR 0026 §5). Required when `S3_BUCKET` is set.
# S3_ENDPOINT=

# SigV4 region for the bucket. Railway reports `auto`, which is also the adapter default when
# unset.
# S3_REGION=

# Access key id of the Railway Bucket credentials (`railway bucket credentials --bucket files
# --json` → `accessKeyId`). Required when `S3_BUCKET` is set. Named `S3_*`, not `AWS_*`, so the
# AWS SDK credential chain used for Bedrock never picks it up (ADR 0026 §3).
# (SECRET -- never commit a real value)
# S3_ACCESS_KEY_ID=

# Secret access key of the Railway Bucket credentials (`railway bucket credentials --bucket files
# --json` → `secretAccessKey`). Required when `S3_BUCKET` is set. Rotate with `railway bucket
# credentials --bucket files --reset --yes`, then re-set both `S3_*` secrets on api and worker.
# (SECRET -- never commit a real value)
# S3_SECRET_ACCESS_KEY=

# Local-disk adapter only: base URL returned by `getSignedUrl` instead of `file://` paths.
# STORAGE_PUBLIC_BASE_URL=

# Local-disk adapter only: directory that holds stored objects. Defaults to `.data/storage`
# (gitignored) when unset.
# STORAGE_ROOT=

# Amazon Bedrock API key (bearer). Required in production; when unset in development/test `@tj/ai`
# is `unconfigured` and AI jobs/routes fail fast. Never set on Vercel (ADR 0018).
# (SECRET -- never commit a real value)
# AWS_BEARER_TOKEN_BEDROCK=

# Amazon Bedrock region. `us-east-1` is the data-residency deviation recorded in ADR 0016 §5;
# production uses this value (ADR 0018).
AWS_REGION=us-east-1

# Bedrock model ID for the F13 §7 frontier class: planning, adaptation and coherence.
AI_MODEL_FRONTIER=us.openai.gpt-5.6-sol

# Bedrock model ID for the F13 §7 standard class: plan, notes and slide outline generation.
AI_MODEL_STANDARD=us.openai.gpt-5.6-terra

# Bedrock model ID for the F13 §7 small class: items, glossary, variants and summaries.
AI_MODEL_SMALL=us.openai.gpt-5.6-luna

# Pexels API key for photo search. Read once at boot; when unset `GET /images/search` answers
# `503` and the pipeline skips placements instead of failing the boot. Set on Railway, never in
# git.
# (SECRET -- never commit a real value)
# PEXELS_API_KEY=

# Mastra core is used in-process by @tj/generation (ADR 0025 §21); its anonymous telemetry
# (`posthog-node`) is disabled.
MASTRA_TELEMETRY_DISABLED=1

# Concurrent SSE streams per Workspace before `429 rate_limited` (default 20).
# EVENTS_MAX_STREAMS_PER_WORKSPACE=

# Most `job_events` rows replayed when a stream opens (default 500, max 5000).
# EVENTS_REPLAY_LIMIT=

# Interval of the `: ping` SSE comment that keeps proxies awake (default 15000).
# EVENTS_HEARTBEAT_MS=

# Poll interval while the LISTEN connection is down — degraded mode (default 1000).
# EVENTS_POLL_MS=

# Model-call requests per Workspace per window on `POST /jobs/ai-ping` before `429 rate_limited`
# (default 10).
# AI_RATE_LIMIT_PER_WORKSPACE=

# Window length in seconds for `AI_RATE_LIMIT_PER_WORKSPACE` (default 60).
# AI_RATE_LIMIT_WINDOW_S=

# Photo-search requests per Workspace per window on `GET /images/search` before `429 rate_limited`
# (default 30).
# IMAGE_RATE_LIMIT_PER_WORKSPACE=

# Window length in seconds for `IMAGE_RATE_LIMIT_PER_WORKSPACE` (default 60).
# IMAGE_RATE_LIMIT_WINDOW_S=

# Uploads per Workspace per window on `POST /sources` before `429 rate_limited` (default 30).
# Extraction runs in the request (ADR 0027 §1).
# SOURCE_RATE_LIMIT_PER_WORKSPACE=

# Window length in seconds for `SOURCE_RATE_LIMIT_PER_WORKSPACE` (default 60).
# SOURCE_RATE_LIMIT_WINDOW_S=
