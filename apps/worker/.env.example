# @tj/worker -- copied to `.env` by `bun run setup` (never overwritten). Bun loads `.env` from the
# process cwd only, so `bun run dev` inside apps/worker reads this file. Local development uses
# synthetic data only -- never point DATABASE_URL at production.

# Postgres connection (same database as apps/api; pg-boss installs its own `pgboss` schema).
# Keep the port in sync with TJ_PG_PORT in the root `.env`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey

# Jobs processed concurrently per queue in this process.
WORKER_CONCURRENCY=4

# Health endpoint: GET http://localhost:3002/health
PORT=3002

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# development enables pino-pretty output.
NODE_ENV=development
