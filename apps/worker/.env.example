# @tj/worker -- copied to `.env` by `bun run setup` (never overwritten). Bun loads `.env` from
# the process cwd only, so `bun run dev` inside apps/worker reads this file.
#
# GENERATED from infra/env.contract.ts by `bun run env:generate` -- do not edit by hand.
# Local development uses synthetic data only -- never point DATABASE_URL at production.

# Postgres connection of the app database (pg-boss installs its own `pgboss` schema in it).
# Locally the compose database; keep the port in sync with TJ_PG_PORT. On Railway a reference to
# the `postgres` service over the private network. Contains the password: treat as a secret.
# (SECRET -- never commit a real value)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey

# development | test | production. `development` switches on pino-pretty; `production` refuses
# ENABLE_TEST_ROUTES and ALLOW_WORKSPACE_HEADER_SHIM.
# (one of: development | test | production)
NODE_ENV=development

# TCP port of Bun.serve: api 3001 (HTTP + SSE), worker 3002 (`/health` only). Railway routes the
# public domain to the api's PORT; the worker has no public domain.
PORT=3002

# pino level: fatal | error | warn | info | debug | trace | silent.
# (one of: fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# Jobs processed concurrently per queue in one worker process (1-64).
WORKER_CONCURRENCY=4

# The daily `auth.anonymous-cleanup` job deletes anonymous users older than this many days whose
# Workspace was not claimed, with their lessons and stored files (TEACH-222). Default 14.
# ANONYMOUS_USER_TTL_DAYS=

# Bucket name of the Railway Bucket `files` (`ams`; `railway bucket credentials --bucket files
# --json` → `bucketName`; infra/README.md "Railway Bucket (files)"). When set (non-blank)
# `@tj/storage` picks `S3Storage` and the other `S3_*` variables become required; otherwise the
# local-disk adapter under `.data/`. Set on Railway api + worker (TEACH-142); never on Vercel —
# the SPA does not read it. Optional in CI to run the S3 contract tests.
# S3_BUCKET=

# S3 API endpoint of the Railway Bucket (`railway bucket credentials` → `endpoint`). Requests are
# path-style (`<endpoint>/<bucket>/<key>`, ADR 0026 §5). Required when `S3_BUCKET` is set.
# S3_ENDPOINT=

# SigV4 region for the bucket. Railway reports `auto`, which is also the adapter default when
# unset.
# S3_REGION=

# Access key id of the Railway Bucket credentials (`railway bucket credentials --bucket files
# --json` → `accessKeyId`). Required when `S3_BUCKET` is set. Named `S3_*`, not `AWS_*`, so the
# AWS SDK credential chain used for Bedrock never picks it up (ADR 0026 §3).
# (SECRET -- never commit a real value)
# S3_ACCESS_KEY_ID=

# Secret access key of the Railway Bucket credentials (`railway bucket credentials --bucket files
# --json` → `secretAccessKey`). Required when `S3_BUCKET` is set. Rotate with `railway bucket
# credentials --bucket files --reset --yes`, then re-set both `S3_*` secrets on api and worker.
# (SECRET -- never commit a real value)
# S3_SECRET_ACCESS_KEY=

# Local-disk adapter only: base URL returned by `getSignedUrl` instead of `file://` paths.
# STORAGE_PUBLIC_BASE_URL=

# Local-disk adapter only: directory that holds stored objects. Defaults to `.data/storage`
# relative to the process cwd when unset — the api and the worker must point at the **same**
# directory (the worker reads what `POST /sources` wrote, ADR 0027 §6); `bun run dev` and the e2e
# config set it for both.
# STORAGE_ROOT=

# Amazon Bedrock API key (bearer). Serves the Bedrock model ids (no slash), the production default
# (ADR 0018). Required in production unless `OPENAI_API_KEY` is set (ADR 0031); when unset in
# development/test those ids fail fast at `model()`. Never set on Vercel.
# (SECRET -- never commit a real value)
# AWS_BEARER_TOKEN_BEDROCK=

# OpenAI API key for the direct route (ADR 0031): serves every `openai/<model>` model id directly,
# and so every default model class (`openai/gpt-6-luna`, decision 25–26 Sept 2026). Required in
# production unless `AWS_BEARER_TOKEN_BEDROCK` is set (and then every `AI_MODEL_*` must name a
# Bedrock id); when unset in development/test those ids fail fast at `model()`. Set on Railway
# (api and worker), never on Vercel, never in git.
# (SECRET -- never commit a real value)
# OPENAI_API_KEY=

# Vercel AI Gateway key. Optional fallback (ADR 0031): when set, `@tj/ai` routes any non-OpenAI
# `provider/model` model id (e.g. `google/gemini-3.8-flash`) through the gateway, and `openai/`
# ids too when `OPENAI_API_KEY` is unset; when unset those ids are unavailable and the other ids
# are unaffected. Never the production path. Set on Railway, never in git.
# (SECRET -- never commit a real value)
# AI_GATEWAY_API_KEY=

# Amazon Bedrock region. `us-east-1` is the data-residency deviation recorded in ADR 0016 §5;
# production uses this value (ADR 0018).
AWS_REGION=us-east-1

# Model ID for the F13 §7 frontier class (the eval judge). Default `openai/gpt-6-luna` on every
# class, served by OpenAI directly with `OPENAI_API_KEY` (decision 25–26 Sept 2026, SHIP-H-PLAN §3
# item 9); a Bedrock `us.openai.*` id routes to Bedrock instead. A value set on Railway overrides
# the default.
AI_MODEL_FRONTIER=openai/gpt-6-luna

# Model ID for the F13 §7 standard class: plan, notes and slide outline generation. Default
# `openai/gpt-6-luna` (OpenAI direct, `OPENAI_API_KEY`); a value set on Railway overrides it.
AI_MODEL_STANDARD=openai/gpt-6-luna

# Model ID for the F13 §7 small class: items, glossary, variants and summaries. Default
# `openai/gpt-6-luna` (OpenAI direct, `OPENAI_API_KEY`); a value set on Railway overrides it.
AI_MODEL_SMALL=openai/gpt-6-luna

# Pexels API key for photo search. Read once at boot; when unset `GET /images/search` answers
# `503` and the pipeline skips placements instead of failing the boot. Set on Railway, never in
# git.
# (SECRET -- never commit a real value)
# PEXELS_API_KEY=

# Default 5. USD the picture generator may spend in one UTC day, per worker process (TEACH-237).
# Once spent, a picture slot routed to generation keeps its placeholder, no generation call is
# made, and one log line says so.
# IMAGE_GENERATION_DAILY_CAP_USD=

# Default `off`. `on` lets the writer planner's picture director reuse judged pictures from the
# shared picture library (`bank_images`, TEACH-84 part b) and store each picture its judge passes,
# so the library grows. A reuse is a cosine of at least 0.77 between request embeddings
# (`text-embedding-3-small`, about $0.000004 a lookup) and is judged again before it is placed.
# Needs `OPENAI_API_KEY`; a failed lookup falls through to the live search. `off` searches or
# generates every picture afresh and stores nothing.
# (one of: off | on)
# PICTURE_LIBRARY_REUSE=

# Per-lesson spend cap in USD for the `lesson.plan` pipeline (ADR 0025 §15). Every stage charges
# `createBudget` after each call and stops between calls once the cap is exceeded; what was
# written stays and the teacher is told.
AI_LESSON_COST_CAP_USD=0.50

# Per-lesson input + output token cap, used instead of `AI_LESSON_COST_CAP_USD` once a configured
# model id has no entry in `@tj/ai` `PRICES` (ADR 0025 §15) — the cap is never silently absent.
AI_LESSON_TOKEN_CAP=300000

# Per-worksheet spend cap in USD for the `lesson.worksheet` job (ADR 0030 item 1): one `small`
# fill call and at most one repair, charged to the worksheet's own `generation.usage`, never the
# lesson's. Defaults to 0.10 when unset, so an existing worker service needs no new variable.
AI_WORKSHEET_COST_CAP_USD=0.10

# Spend cap in USD for one paid run of the `@tj/generation` eval set (ADR 0025 §23). Read by the
# eval script only, never by the worker's boot schema.
AI_EVAL_RUN_COST_CAP_USD=3.00

# Plan's three calls (skeleton, facts, Verify) run on the `frontier` class for a lesson whose year
# group is this number or above — e.g. `7` routes Year 7+ to Sol and keeps primary on Terra
# (TEACH-259). Unset: every Plan call is `standard`. Generate never reads it. Not set on Railway
# until the Sol eval says where the line goes.
# AI_PLAN_FRONTIER_FROM_YEAR=

# Reasoning effort every model call in the worker runs at (lesson pipeline and worksheet), through
# `effortFor` (TEACH-72). One of none | low | medium | high | xhigh; anything else stops the
# worker at boot. Unset or blank: `low` (decision 25–26 Sept 2026, SHIP-H-PLAN §3 item 9). Changes
# no model id. Not set on Railway: the default is the shipped value.
# (one of: none | low | medium | high | xhigh)
# AI_REASONING_EFFORT=

# Which planner plans a new lesson (TEACH-93, ADR 0033). `writer` (TEACH-110 part b; production
# defaults to it from 20 Oct 2026, Greg): `lesson.plan` makes the objectives call only, stamped
# for the writer, and stops for the teacher; `lesson.generate` runs the lesson writer (one
# streamed `gpt-6.1-sol` call on `OPENAI_API_KEY`, the bundle pinned in code) and its own checks,
# repair and notes. `objectives-first` (the default from 25–26 Sept to 20 Oct 2026): the same
# objectives call; `lesson.generate` writes the facts in waves and the outline in code, then the
# slides. `legacy`: the skeleton and facts calls in `lesson.plan`. Both stay selectable for
# rollback. A lesson already planned keeps the planner its `promptVersions.planned` stamp names,
# so flipping this never strands one. Anything else stops the worker at boot. Not set on Railway:
# the default is the shipped value; rollback is setting `objectives-first`.
# (one of: legacy | objectives-first | writer)
# AI_LESSON_PLANNER=

# Per-lesson cost target in USD (TEACH-93, default 0.12): a lesson that finishes above it logs one
# `lesson cost above target` warn line with its cost and planner. Never stops a lesson; the stop
# is `AI_LESSON_COST_CAP_USD`. The default is about 1.5x the median real writer lesson ($0.079
# over 20 lab lessons on writer pack v4.8, 20 Oct 2026); the old 0.03 fired on every writer
# lesson.
# AI_LESSON_COST_WARN_USD=

# Days a lesson's debug record (`generation_debug`: the writer's raw output, checks, repairs,
# splits, picture decisions, model calls, a failed job's full error) is kept; the worker's daily
# `generation.debug-cleanup` job deletes older rows (Greg, 20 Oct 2026; ADR 0015 amendment).
# Default 30.
# GENERATION_DEBUG_TTL_DAYS=

# Bedrock model ID the paid eval's rubric judge runs on (TEACH-259). Unset: the `standard` id, so
# the judge is never the model under test when `AI_PLAN_FRONTIER_FROM_YEAR` puts Plan on the
# frontier class. Read by the eval script only, never by the worker's boot schema.
# AI_MODEL_JUDGE=

# "pipeline" replaces Bedrock with the scripted fake from `@tj/generation/testing` (one fixture
# run per job, ADR 0025 §22) so the e2e worker generates lessons without a model. Refused at boot
# when NODE_ENV=production; never set it on Railway.
# (one of: pipeline)
# AI_FAKE_SCRIPT=

# Pause before each scripted fake answer when `AI_FAKE_SCRIPT` is set, so a browser test can watch
# slides arrive one by one. Ignored otherwise.
# AI_FAKE_DELAY_MS=

# Test only (live writing, TEACH-202 part d): a writer replay fixture folder the scripted fake
# streams at its recorded pace for the writer planner. Refused at boot unless
# `AI_FAKE_SCRIPT=pipeline`, which is itself refused when NODE_ENV=production; never set it on
# Railway.
# AI_FAKE_WRITER_REPLAY=

# Mastra core is used in-process by @tj/generation (ADR 0025 §21); its anonymous telemetry
# (`posthog-node`) is disabled.
MASTRA_TELEMETRY_DISABLED=1
