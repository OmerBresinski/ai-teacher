{
  "name": "@tj/worker",
  "version": "0.0.0",
  "private": true,
  "description": "pg-boss consumer for Teaching Journey background jobs (ADR 0006/0012).",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@tj/ai": "workspace:*",
    "@tj/db": "workspace:*",
    "@tj/domain": "workspace:*",
    "@tj/jobs": "workspace:*",
    "pg-boss": "12.30.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tj/config": "workspace:*",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3"
  }
}
