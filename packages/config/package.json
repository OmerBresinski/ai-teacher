{
  "name": "@tj/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig bases, Tailwind preset and Vitest preset for the Teaching Journey monorepo (ADR 0013, 0014).",
  "type": "module",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./tailwind.preset": "./tailwind.preset.ts",
    "./vitest/react": "./vitest/react.ts",
    "./vitest/setup": "./vitest/setup.ts"
  },
  "files": [
    "tsconfig",
    "tailwind.preset.ts",
    "vitest"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.6",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
