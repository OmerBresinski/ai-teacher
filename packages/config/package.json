{
  "name": "@tj/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig bases and Tailwind preset for the Teaching Journey monorepo (ADR 0013).",
  "type": "module",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./tailwind.preset": "./tailwind.preset.ts"
  },
  "files": [
    "tsconfig",
    "tailwind.preset.ts"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "typescript": "5.9.3"
  }
}
