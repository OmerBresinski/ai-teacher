{
  "name": "@tj/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig bases, Tailwind preset and bun test preloads for the Teaching Journey monorepo (ADR 0013, 0014).",
  "type": "module",
  "exports": {
    "./tsconfig/*": "./tsconfig/*",
    "./tailwind.preset": "./tailwind.preset.ts",
    "./bun-test/dom": "./bun-test/dom.ts",
    "./bun-test/setup": "./bun-test/setup.ts",
    "./bun-test/jest-dom": "./bun-test/jest-dom.d.ts"
  },
  "files": [
    "tsconfig",
    "tailwind.preset.ts",
    "bun-test"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.0.11",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.3.6",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  }
}
