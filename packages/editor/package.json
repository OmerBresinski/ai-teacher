{
  "name": "@tj/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Teaching Journey lesson/worksheet editor, viewer, present mode and exporters, ported from TeachDeck (ADR 0022).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./thumb": "./src/thumb.ts",
    "./starter": "./src/starter.ts",
    "./styles/editor.css": "./src/styles/editor.css",
    "./present": "./src/present/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ${CI:+--coverage}",
    "test:watch": "bun test --watch"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@tanstack/react-query": "^5"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/gabarito": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/html": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tj/domain": "workspace:*",
    "@tj/ui": "workspace:*",
    "clsx": "2.1.1",
    "immer": "11.1.18",
    "lucide-react": "1.40.0",
    "nanoid": "5.1.16",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.102.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tj/config": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
