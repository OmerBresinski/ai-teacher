{
  "name": "@tj/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Teaching Journey lesson/worksheet editor, viewer, present mode and exporters, ported from TeachDeck (ADR 0022).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./thumb": "./src/thumb.ts",
    "./theme-picker": "./src/theme-picker.ts",
    "./theme-picker/samples": "./src/theme-picker/samples.ts",
    "./worksheet-thumb": "./src/worksheet-thumb.ts",
    "./styles/worksheet-thumb.css": "./src/styles/worksheet-thumb.css",
    "./starter": "./src/starter.ts",
    "./fixtures": "./src/fixtures.ts",
    "./autosave": "./src/model/use-autosave.ts",
    "./styles/editor.css": "./src/styles/editor.css",
    "./present": "./src/present/index.ts",
    "./lesson": "./src/lesson/index.ts",
    "./live-draft": "./src/lesson/live-draft.tsx",
    "./images": "./src/images/index.ts",
    "./worksheet": "./src/worksheet/index.ts",
    "./styles/print.css": "./src/styles/print.css",
    "./styles/worksheet-edit.css": "./src/styles/worksheet-edit.css",
    "./worksheet-editor": "./src/worksheet/editor-index.ts",
    "./worksheet-metrics": "./src/worksheet/metrics.ts",
    "./export": "./src/export/index.ts",
    "./export/pdf": "./src/export/pdf.ts",
    "./lesson-print": "./src/present/LessonPrint.tsx",
    "./styles/lesson-print.css": "./src/styles/lesson-print.css"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ${CI:+--coverage}",
    "test:watch": "bun test --watch"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@tanstack/react-query": "^5"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/gabarito": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/lexend": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playpen-sans": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/andika": "5.3.0",
    "@tanstack/react-virtual": "3.14.21",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-color": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/html": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tj/domain": "workspace:*",
    "@tj/slides": "workspace:*",
    "@tj/ui": "workspace:*",
    "clsx": "2.1.1",
    "docx": "9.12.0",
    "immer": "11.1.21",
    "jszip": "3.10.2",
    "lucide-react": "1.59.0",
    "modern-screenshot": "4.7.0",
    "nanoid": "6.0.2",
    "pptxgenjs": "4.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tj/config": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "image-size": "workspace:*",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
