exports[`samples venn matches its snapshot (chalk) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 436 356" width="436" height="356" role="img" aria-label="A Venn diagram sorting numbers 1 to 12 into multiples of 2 and multiples of 3."><title>A Venn diagram sorting numbers 1 to 12 into multiples of 2 and multiples of 3.</title><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="24" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="218" y="19.2">Multiples of 2 and 3</tspan></text><g transform="translate(0,40.8)"><g transform="translate(4,0)"><rect x="1" y="1" width="426" height="313.2" rx="12" fill="none" stroke="#b2ada2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="143.66" cy="156.1" r="117.24" fill="#A94A18" fill-opacity="0.2" stroke="none" stroke-width="1.5"/><circle cx="284.34" cy="156.1" r="117.24" fill="#4A5D8C" fill-opacity="0.2" stroke="none" stroke-width="1.5"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="500" fill="#2C2A24" text-anchor="middle"><tspan x="108.49" y="33.36">Multiples of 2</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="500" fill="#2C2A24" text-anchor="middle"><tspan x="319.51" y="33.36">Multiples of 3</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="90.9" y="139.1">2</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="90.9" y="163.1">4</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="90.9" y="187.1">8</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" tex