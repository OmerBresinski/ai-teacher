exports[`samples timeline matches its snapshot (chalk) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 436 356" width="436" height="356" role="img" aria-label="Roman Britain from 55 BC to AD 410."><title>Roman Britain from 55 BC to AD 410.</title><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="24" font-weight="700" fill="#2C2A24" text-anchor="middle"><tspan x="218" y="19.2">Roman Britain</tspan></text><g transform="translate(0,40.8)"><line x1="6" y1="135.6" x2="421.6" y2="135.6" stroke="#2C2A24" stroke-width="2.5" stroke-linecap="round"/><polygon points="430,135.6 419.5,141.9 421.08,135.6 419.5,129.3" fill="#2C2A24"/><line x1="133.2" y1="135.6" x2="387.6" y2="135.6" stroke="#4A5D8C" stroke-width="9" stroke-linecap="round"/><path d="M133.2,234.5 Q133.2,240.55 139.25,240.55 L254.35,240.55 Q260.4,240.55 260.4,246.6 Q260.4,240.55 266.45,240.55 L381.55,240.55 Q387.6,240.55 387.6,234.5" fill="none" stroke="#4A5D8C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="700" fill="#2C2A24" text-anchor="middle"><tspan x="260.4" y="263.7">Roman rule</tspan></text><rect x="340.36" y="125.7" width="9.68" height="19.8" fill="#FAF4E6"/><line x1="335.52" y1="145.5" x2="345.2" y2="125.7" stroke="#2C2A24" stroke-width="2.5" stroke-linecap="round"/><line x1="345.2" y1="145.5" x2="354.88" y2="125.7" stroke="#2C2A24" stroke-width="2.5" stroke-linecap="round"/><line x1="48.4" y1="135.6" x2="48.4" y2="118.8" stroke="#6E6656" stroke-width="1.75"/><circle cx="48.4" cy="135.6" r="7.04" fill="#A94A18" stroke="#FAF4E6" stroke-width="1.75"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="70.13" y="62">55 BC</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="500" fill="#2C2A24" text-anchor="middle