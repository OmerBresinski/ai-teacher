exports[`samples pie matches its snapshot (chalk) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 436 356" width="436" height="356" role="img" aria-label="A pie chart of land use: farmland half, woodland a quarter, towns and water the rest."><title>A pie chart of land use: farmland half, woodland a quarter, towns and water the rest.</title><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="24" font-weight="700" fill="#2C2A24" text-anchor="middle"><tspan x="218" y="19.2">Land use in the valley</tspan></text><g transform="translate(0,40.8)"><path d="M102.66,157.6 L102.66,60.94 A96.66,96.66 0 0 1 102.66,254.26 Z" fill="#A94A18" stroke="#2C2A24" stroke-width="2.5" stroke-linejoin="round"/><path d="M102.66,157.6 L102.66,254.26 A96.66,96.66 0 0 1 6,157.6 Z" fill="#4A5D8C" stroke="#2C2A24" stroke-width="2.5" stroke-linejoin="round"/><path d="M102.66,157.6 L6,157.6 A96.66,96.66 0 0 1 45.85,79.4 Z" fill="#d8ab8f" stroke="#2C2A24" stroke-width="2.5" stroke-linejoin="round"/><path d="M102.66,157.6 L45.85,79.4 A96.66,96.66 0 0 1 102.66,60.94 Z" fill="#aeb4c3" stroke="#2C2A24" stroke-width="2.5" stroke-linejoin="round"/><rect x="215.32" y="99.3" width="17.6" height="17.6" rx="3" fill="#A94A18" stroke="#2C2A24" stroke-width="1.75"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="500" fill="#2C2A24" text-anchor="start"><tspan x="241.72" y="115.8">Farmland (50%)</tspan></text><rect x="215.32" y="132.3" width="17.6" height="17.6" rx="3" fill="#4A5D8C" stroke="#2C2A24" stroke-width="1.75"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="500" fill="#2C2A24" text-anchor="start"><tspan x="241.72" y="148.8">Woodland (25%)</tspan></text><rect x="215.32" y="165.3" width="17.6" height="17.6" rx="3" fill="#d8ab8f" stroke="#2C2A24" stroke-width="1.75"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="500" fill="#2C2A24"