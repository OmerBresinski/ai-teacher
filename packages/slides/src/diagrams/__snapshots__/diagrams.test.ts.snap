exports[`samples table matches its snapshot (chalk) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 436 356" width="436" height="356" role="img" aria-label="The three states of matter compared by arrangement, movement and energy."><title>The three states of matter compared by arrangement, movement and energy.</title><rect x="0" y="67.8" width="436" height="38" fill="#A94A18"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="700" fill="#FAF4E6" text-anchor="start"><tspan x="11.4" y="93.45">State</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="700" fill="#FAF4E6" text-anchor="start"><tspan x="93.95" y="93.45">Arrangement</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="700" fill="#FAF4E6" text-anchor="start"><tspan x="264.01" y="93.45">Movement</tspan></text><rect x="0" y="105.8" width="436" height="60.8" fill="#FFFBF0"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="600" fill="#2C2A24" text-anchor="start"><tspan x="11.4" y="142.85">Solid</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="93.95" y="131.45">Regular,</tspan><tspan x="93.95" y="154.25">touching</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="264.01" y="142.85">Vibrate in place</tspan></text><rect x="0" y="166.6" width="436" height="60.8" fill="#f1dfcd"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="600" fill="#2C2A24" text-anchor="start"><tspan x="11.4" y="203.65">Liquid</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="93.95" y="192.25">Random,</tspan><tspan x="93.95" y="215.05">touching</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="264.01" y="192.25">Slide past each</tspan><tspan x="264.01" y="215.05">other</tspan></text><rect x="0" y="227.4" width="436" height="60.8" fill="#FFFBF0"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="600" fill="#2C2A24" text-anchor="start"><tspan x="11.4" y="264.45">Gas</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="93.95" y="253.05">Random, far</tspan><tspan x="93.95" y="275.85">apart</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="264.01" y="253.05">Move fast in all</tspan><tspan x="264.01" y="275.85">directions</tspan></text><line x1="82.55" y1="67.8" x2="82.55" y2="288.2" stroke="#E7DCC4" stroke-width="1.5"/><line x1="252.61" y1="67.8" x2="252.61" y2="288.2" stroke="#E7DCC4" stroke-width="1.5"/><line x1="0" y1="105.8" x2="436" y2="105.8" stroke="#E7DCC4" stroke-width="1.5"/><line x1="0" y1="166.6" x2="436" y2="166.6" stroke="#E7DCC4" stroke-width="1.5"/><line x1="0" y1="227.4" x2="436" y2="227.4" stroke="#E7DCC4" stroke-width="1.5"/><rect x="0" y="67.8" width="436" height="220.4" fill="none" stroke="#2C2A24" stroke-width="2"/></svg>"`;
