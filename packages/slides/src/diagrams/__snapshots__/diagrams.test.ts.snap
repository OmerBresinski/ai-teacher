exports[`samples carroll matches its snapshot (chalk) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 436 356" width="436" height="356" role="img" aria-label="A Carroll diagram sorting shapes by whether they have right angles and four sides."><title>A Carroll diagram sorting shapes by whether they have right angles and four sides.</title><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="24" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="218" y="19.2">Sorting shapes</tspan></text><g transform="translate(0,40.8)"><g transform="translate(4,0)"><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="203.3" y="29.7">4 sides</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="353.1" y="29.7">Not 4 sides</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="64.2" y="106.3">Right</tspan><tspan x="64.2" y="132.7">angle</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="64.2" y="241.9">No right</tspan><tspan x="64.2" y="268.3">angle</tspan></text><rect x="128.4" y="44" width="149.8" height="135.6" fill="#f3e2d2" stroke="none" stroke-width="1.5" rx="6"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="203.3" y="106.3">square</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="203.3" y="131.3">rectangle</tspan></text><rect x="278.2" y="44" width="149.8" height="135.6" fill="#f2eee4" stroke="none" stroke-width="1.5" rx="6"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="353.1" y="118.8">right triangle</tspan></text><rect x="128.4" y="179.6" width="149.8" height="135.6" fill="#f2eee4" stroke="none" stroke-width="1.5" rx="6"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="203.3" y="241.9">rhombus</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="203.3" y="266.9">kite</tspan></text><rect x="278.2" y="179.6" width="149.8" height="135.6" fill="#f3e2d2" stroke="none" stroke-width="1.5" rx="6"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="353.1" y="241.9">pentagon</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="20" font-weight="400" fill="#2C2A24" text-anchor="middle"><tspan x="353.1" y="266.9">hexagon</tspan></text></g></g></svg>"`;

