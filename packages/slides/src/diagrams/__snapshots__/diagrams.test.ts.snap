exports[`samples bar-chart matches its snapshot (chalk) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 436 356" width="436" height="356" role="img" aria-label="A bar chart of how pupils travel to school: walk 12, bus 8, car 6, bike 3."><title>A bar chart of how pupils travel to school: walk 12, bus 8, car 6, bike 3.</title><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="24" font-weight="600" fill="#2C2A24" text-anchor="middle"><tspan x="218" y="19.2">How we travel to school</tspan></text><g transform="translate(0,40.8)"><g transform="translate(4,0)"><line x1="58.51" y1="253.6" x2="422" y2="253.6" stroke="#d5d0c3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="600" fill="#2C2A24" text-anchor="end"><tspan x="50.51" y="260.25">0</tspan></text><line x1="58.51" y1="194" x2="422" y2="194" stroke="#d5d0c3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="600" fill="#2C2A24" text-anchor="end"><tspan x="50.51" y="200.65">3</tspan></text><line x1="58.51" y1="134.4" x2="422" y2="134.4" stroke="#d5d0c3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="600" fill="#2C2A24" text-anchor="end"><tspan x="50.51" y="141.05">6</tspan></text><line x1="58.51" y1="74.8" x2="422" y2="74.8" stroke="#d5d0c3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="19" font-weight="600" fill="#2C2A24" text-anchor="end"><tspan x="50.51" y="81.45">9</tspan></text><line x1="58.51" y1="15.2" x2="422" y2="15.2" stroke="#d5d0c3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><text font-family="'Lexend Variable', 'Trebuch