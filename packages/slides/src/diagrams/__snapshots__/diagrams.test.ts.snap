exports[`samples table matches its snapshot (chalk) 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 436 356" width="436" height="356" role="img" aria-label="The three states of matter compared by arrangement, movement and energy."><title>The three states of matter compared by arrangement, movement and energy.</title><rect x="0" y="0" width="436" height="44" fill="#A94A18"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="700" fill="#FAF4E6" text-anchor="start"><tspan x="13.2" y="29.7">State</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="700" fill="#FAF4E6" text-anchor="start"><tspan x="108.79" y="29.7">Arrangement</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="700" fill="#FAF4E6" text-anchor="start"><tspan x="288.95" y="29.7">Movement</tspan></text><rect x="0" y="44" width="436" height="70.4" fill="#FFFBF0"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="start"><tspan x="13.2" y="86.9">Solid</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="108.79" y="73.7">Regular,</tspan><tspan x="108.79" y="100.1">touching</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="288.95" y="73.7">Vibrate in</tspan><tspan x="288.95" y="100.1">place</tspan></text><rect x="0" y="114.4" width="436" height="70.4" fill="#f1dfcd"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="start"><tspan x="13.2" y="157.3">Liquid</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="108.79" y="144.1">Random,</tspan><tspan x="108.79" y="170.5">touching</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="288.95" y="144.1">Slide past</tspan><tspan x="288.95" y="170.5">each other</tspan></text><rect x="0" y="184.8" width="436" height="96.8" fill="#FFFBF0"/><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="600" fill="#2C2A24" text-anchor="start"><tspan x="13.2" y="240.9">Gas</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="108.79" y="227.7">Random, far</tspan><tspan x="108.79" y="254.1">apart</tspan></text><text font-family="'Lexend Variable', 'Trebuchet MS', sans-serif" font-size="22" font-weight="400" fill="#2C2A24" text-anchor="start"><tspan x="288.95" y="214.5">Move fast in</tspan><tspan x="288.95" y="240.9">all</tspan><tspan x="288.95" y="267.3">directions</tspan></text><line x1="95.59" y1="0" x2="95.59" y2="281.6" stroke="#E7DCC4" stroke-width="1.5"/><line x1="275.75" y1="0" x2="275.75" y2="281.6" stroke="#E7DCC4" stroke-width="1.5"/><line x1="0" y1="44" x2="436" y2="44" stroke="#E7DCC4" stroke-width="1.5"/><line x1="0" y1="114.4" x2="436" y2="114.4" stroke="#E7DCC4" stroke-width="1.5"/><line x1="0" y1="184.8" x2="436" y2="184.8" stroke="#E7DCC4" stroke-width="1.5"/><rect x="0" y="0" width="436" height="281.6" fill="none" stroke="#2C2A24" stroke-width="2"/></svg>"`;
