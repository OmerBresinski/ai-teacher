{
  "name": "@tj/slides",
  "version": "0.0.0",
  "private": true,
  "description": "Pure slide recipes: theme catalogue, grid, layoutSlide, rich-doc builders and materialiseSlide/materialiseBlock; shared by @tj/editor and @tj/generation (ADR 0025 §9).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./grid": "./src/grid.ts",
    "./geometry": "./src/geometry.ts",
    "./fonts": "./src/fonts.ts",
    "./themes": "./src/themes.ts",
    "./factories": "./src/factories.ts",
    "./layouts": "./src/layouts.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@tj/config": "workspace:*",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@tj/domain": "workspace:*",
    "nanoid": "5.1.16",
    "zod": "4.5.4"
  }
}
