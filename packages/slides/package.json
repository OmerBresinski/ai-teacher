{
  "name": "@tj/slides",
  "version": "0.0.0",
  "private": true,
  "description": "Pure slide and worksheet recipes: theme catalogue, grid, layoutSlide, rich-doc builders, materialiseSlide/materialiseBlock and the worksheet recipes; shared by @tj/editor and @tj/generation (ADR 0025 §9, ADR 0030 §4).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./grid": "./src/grid.ts",
    "./geometry": "./src/geometry.ts",
    "./fonts": "./src/fonts.ts",
    "./themes": "./src/themes.ts",
    "./factories": "./src/factories.ts",
    "./layouts": "./src/layouts.ts",
    "./reflow": "./src/reflow.ts",
    "./worksheet": "./src/worksheet/index.ts",
    "./diagrams": "./src/diagrams/index.ts",
    "./templates": "./src/templates/index.ts",
    "./templates/pupil-words": "./src/templates/pupil-words.ts",
    "./templates/activities": "./src/templates/activities.ts",
    "./templates/activity-capacity.json": "./src/templates/activity-capacity.json",
    "./templates/fits-extra.json": "./src/templates/fits-extra.gen.json",
    "./diagram-builds": "./src/diagrams/builds.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@tj/config": "workspace:*",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@tj/domain": "workspace:*",
    "nanoid": "6.0.1",
    "zod": "4.6.5"
  }
}
