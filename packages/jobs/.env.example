# @tj/jobs -- local settings for `bun test` inside packages/jobs.
#
# Bun loads `.env` from the process cwd only. The integration tests connect to TEST_DATABASE_URL
# (never DATABASE_URL), truncate its tables and install pg-boss into the `pgboss_test` schema.
# They skip visibly when this is unset or the server is unreachable.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey_test
