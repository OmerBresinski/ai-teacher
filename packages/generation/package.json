{
  "name": "@tj/generation",
  "version": "0.0.0",
  "private": true,
  "description": "Lesson generation pipeline: Plan / Generate / Evaluate / Repair stages over typed state, versioned prompts, structured calls with one retry, budget wiring and the in-process Mastra workflow (ADR 0025 §5, §8, §11–17, §21). Server-only; consumed by apps/worker.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./mastra": "./src/mastra.dev.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@tj/config": "workspace:*",
    "@types/bun": "1.4.1",
    "mastra": "1.27.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mastra/core": "1.64.0",
    "@tj/ai": "workspace:*",
    "@tj/domain": "workspace:*",
    "@tj/images": "workspace:*",
    "@tj/slides": "workspace:*",
    "ai": "7.0.93",
    "pino": "10.3.1",
    "zod": "4.5.4"
  }
}
