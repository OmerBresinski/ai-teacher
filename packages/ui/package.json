{
  "name": "@tj/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Teaching Journey design system: Tailwind v4 + shadcn/ui components with data-theme switching (ADR 0009).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ${CI:+--coverage}",
    "test:watch": "bun test --watch"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.2.5",
    "lucide-react": "1.40.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tj/config": "workspace:*",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
