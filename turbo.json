{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["//#lint:root"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "lint:fix": {
      "dependsOn": ["//#lint:root:fix"],
      "cache": false
    },
    "format": {
      "dependsOn": ["//#format:root"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["*.json", "*.ts"]
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "//#format:root": {
      "cache": false
    }
  }
}
