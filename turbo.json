{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.agents/**",
        "!**/.claude/**",
        "!**/.opencode/**",
        "!AGENTS.md",
        "!skills-lock.json"
      ]
    },
    "lint": {
      "dependsOn": ["//#lint:root"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/biome.json",
        "!**/.agents/**",
        "!**/.claude/**",
        "!**/.opencode/**",
        "!AGENTS.md",
        "!skills-lock.json"
      ]
    },
    "lint:fix": {
      "dependsOn": ["//#lint:root:fix"],
      "cache": false
    },
    "format": {
      "dependsOn": ["//#format:root"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "//#typecheck:root"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.agents/**",
        "!**/.claude/**",
        "!**/.opencode/**",
        "!AGENTS.md",
        "!skills-lock.json"
      ]
    },
    "test": {
      "dependsOn": ["//#test:scripts"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.agents/**",
        "!**/.claude/**",
        "!**/.opencode/**",
        "!AGENTS.md",
        "!skills-lock.json"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["*.json", "*.ts", "scripts/**/*.ts", "biome.json"]
    },
    "//#typecheck:root": {
      "inputs": [
        "tsconfig.json",
        "*.ts",
        "scripts/**/*.ts",
        "$TURBO_ROOT$/packages/config/tsconfig/*.json"
      ]
    },
    "//#test:scripts": {
      "inputs": ["scripts/**/*.ts"]
    },
    "//#lint:root:fix": {
      "cache": false
    },
    "//#format:root": {
      "cache": false
    }
  }
}
