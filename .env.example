# Teaching Journey -- root environment for LOCAL development (TEACH-18, TEACH-26).
#
# GENERATED from infra/env.contract.ts by `bun run env:generate` -- do not edit by hand.
# `bun run setup` copies this file to `.env` once and never overwrites it. `.env` is gitignored.
# Everything here targets the docker-compose Postgres only; never put production credentials in
# a local env file (F15 section 5: development uses synthetic data only).
#
# Who reads the root `.env`:
#   - docker compose: reads `.env` from this directory automatically (ports below).
#   - the root scripts (`bun run setup | dev | doctor | db:*`): Bun loads `.env` from the cwd.
#   - workspaces (apps/*, packages/*) do NOT see this file. Each app/package that reads env keeps
#     its own `.env.example` -> `.env` next to its package.json (ADR 0015); `setup` copies those
#     too and `doctor` validates every `.env` against docs/env.md.

# Host port docker compose publishes Postgres on. The single knob for a port conflict: the root
# scripts derive DATABASE_URL / TEST_DATABASE_URL from it when those are unset. Shell wins over
# the file (`TJ_PG_PORT=5433 bun run db:up`).
TJ_PG_PORT=5432

# Postgres connection of the app database (pg-boss installs its own `pgboss` schema in it).
# Locally the compose database; keep the port in sync with TJ_PG_PORT. On Railway a reference to
# the `postgres` service over the private network. Contains the password: treat as a secret.
# (SECRET -- never commit a real value)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey

# Database the test suites and Playwright use (`@tj/db/testing`, docs/testing.md). Tests TRUNCATE
# tables here, so it must never equal DATABASE_URL. Never read by a running server.
# (SECRET -- never commit a real value)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey_test
