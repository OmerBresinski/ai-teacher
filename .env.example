# Teaching Journey -- root environment for LOCAL development (TEACH-18).
#
# `bun run setup` copies this file to `.env` once and never overwrites it. `.env` is gitignored.
# Everything here targets the docker-compose Postgres only; never put production credentials in
# a local env file (F15 section 5: development uses synthetic data only).
#
# Who reads the root `.env`:
#   - docker compose: reads `.env` from this directory automatically (ports below).
#   - the root scripts (`bun run setup | dev | doctor | db:*`): Bun loads `.env` from the cwd.
#   - workspaces (apps/*, packages/*) do NOT see this file. Each app/package that reads env keeps
#     its own `.env.example` -> `.env` next to its package.json (ADR 0015); `setup` copies those
#     too and `doctor` checks that every `.env` has all the keys of its `.env.example`.

# Host port Postgres is published on. Change it if another Postgres already owns 5432.
# The shell wins over this file (`TJ_PG_PORT=5433 bun run db:up`). Compose, `setup`, `dev` and
# `doctor` all honour it.
TJ_PG_PORT=5432

# Connection strings for the compose databases. When unset, the scripts derive them from
# TJ_PG_PORT, so TJ_PG_PORT is the single knob for a port conflict. Uncomment only to point at a
# different server -- and keep the port in sync with TJ_PG_PORT (`doctor` warns if it is not).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/teaching_journey_test

# App origins are NOT root settings. They are set in apps/*/.env.example when those apps land
# (TEACH-16 api, TEACH-21 web):
#   WEB_ORIGIN=http://localhost:5173
#   VITE_API_URL=http://localhost:3001
# The web app proxies `/api` through the Vite dev server so auth cookies stay same-origin.
